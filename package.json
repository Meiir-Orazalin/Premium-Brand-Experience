{
  "name": "m-coffee",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "4.16.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3",
    "sass": "^1",
    "tailwindcss": "^4",
    "typescript": "~5.9.0",
    "vitest": "^4"
  }
}
